+}
+
+// A group's sender push name is never its subject. An empty result preserves
+// the existing stored title when a metadata lookup is temporarily unavailable.
+// Broadcast lists keep upstream's contact, push name, JID order (#550).
+func chatNameFallback(chat types.JID, pushName, fallback string) string {
+	if chat.Server == types.GroupServer {
+		return ""
+	}
 	if name := strings.TrimSpace(pushName); name != "" && name != "-" {
 		return name
 	}
