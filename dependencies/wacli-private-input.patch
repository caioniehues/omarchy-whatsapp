@@ -0,0 +1,27 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+// OmaWhatsApp: a failed group lookup must not rename a known group after
+// whoever sent the next message.
+func TestFailedGroupLookupKeepsStoredSubject(t *testing.T) {
+	a := newTestApp(t)
+	f := newFakeWA()
+	a.wa = f
+	ctx := context.Background()
+	f.groups[testGroupJID] = testGroup("Project")
+	storeGroupText(t, ctx, a, "m1")
+	assertGroupChatName(t, a, "Project")
+
+	f.mu.Lock()
+	f.groupInfoErr = errors.New("synthetic metadata outage")
+	f.mu.Unlock()
+	a.forgetGroupInfo(testGroupJID)
+	storeGroupText(t, ctx, a, "m2")
+	assertGroupInfoCalls(t, f, 2)
+	assertGroupChatName(t, a, "Project")
+}
